PORT=5177
STORAGE_DRIVER=local
# Optional PostgreSQL storage: STORAGE_DRIVER=postgres
# Use the pooled URL for Neon/Vercel. Never expose this URL to the browser.
DATABASE_URL=
# Optional direct URL for initialization (falls back to DATABASE_URL).
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=3
# Optional PEM CA certificate for providers using a private CA.
DATABASE_SSL_CA=
# Set a password of at least 12 characters. There is no default password.
ADMIN_PASSWORD=
# Set an independent random secret of at least 32 characters.
SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
# Explicitly choose a model available to your Anthropic account.
ANTHROPIC_MODEL=
# For Sheets: STORAGE_DRIVER=sheets and set the following environment variables.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# The origin of the published application, without a trailing slash.
APP_ORIGIN=
